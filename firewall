#!/bin/bash

# Ketentuan:
# 1. Semua boleh akses port 22, 80, 443, dan 1194
# 2. Whitelist didahulukan
# 3. Bila whitelist tidak ada maka terapkan blacklist
# 4. Bila tidak ada keduanya maka semua boleh


IP_FILE="/var/log/openvpn/ipp.txt"
PROXY_FILE="/var/log/openvpn/proxy.txt"
SERVER_PORTS="22,80,443,1194"
VPN_IP=$1
VPN_PORTS=""
IS_CHANGED=""


if ! ipset list whitelist >/dev/null 2>&1; then
    ipset create whitelist hash:ip
fi

if ! ipset list blacklist >/dev/null 2>&1; then
    ipset create blacklist hash:ip
fi


get_blacklist() {
    ipset list blacklist | sed -n '/Members/,$p' | tail -n +2 | tr '\n' ' '
}


get_whitelist() {
    ipset list whitelist | sed -n '/Members/,$p' | tail -n +2 | tr '\n' ' '
}


run() {
    local cmd=$1
    echo "  $cmd"
    eval $cmd || exit 1
    IS_CHANGED="y"
}
 

whitelist_ips=$(get_whitelist)
blacklist_ips=$(get_blacklist)

if [ -f "$PROXY_FILE" ]; then
    user=$(cat $PROXY_FILE | awk -F':' '{print $1}')
    VPN_PORTS=$(cat $PROXY_FILE | awk -F':' '{print $2}')
    if [ -z "$VPN_IP" ] && [ -f $IP_FILE ]; then
        user_ip=$(grep ^$user, $IP_FILE)
        if [ -n "$user_ip" ]; then
            VPN_IP=$(echo $user_ip | awk -F',' 'NF >= 2 {print $2}')
        fi
    fi
fi

line=$(iptables -t nat -S PREROUTING | grep -e "-j DNAT" | head -n 1)
if [ -n "$line" ]; then
    PUBLIC_IP=$(grep -oP '(?<=-d )[0-9.]+' <<< "$line")
else
    echo "Dapatkan IP publik ..."
    cmd="curl -s -4 ifconfig.me"
    echo "  $cmd"
    PUBLIC_IP=$(eval $cmd) || exit 1
    echo "    $PUBLIC_IP"
fi


reject_proxy() {
    if [ -f "$PROXY_FILE" ]; then
        while IFS= read -r line; do
            echo "Hapus proxy untuk semua karena ada file $PROXY_FILE ..."
            run "${line/#-A/iptables -t nat -D}"
        done < <(iptables -t nat -S POSTROUTING | grep -e "POSTROUTING -j MASQUERADE") || exit 1
        while IFS= read -r line; do
            ip=$(grep -oP '(?<=-s )[0-9.]+' <<< "$line")
            if [ "$ip" = "$VPN_IP" ]; then
                continue
            fi
            echo "Hapus proxy untuk $ip karena tidak terdaftar di file $PROXY_FILE ..."
            run "${line/#-A/iptables -t nat -D}"
        done < <(iptables -t nat -S POSTROUTING | grep -e "-s ")
    else
        while IFS= read -r line; do
            echo "Hapus proxy karena semua boleh, tidak ada file $PROXY_FILE ..."
            run "${line/#-A/iptables -t nat -D}"
        done < <(iptables -t nat -S POSTROUTING | grep -e "-j MASQUERADE" | grep -e "-s ") || exit 1
    fi
}


allow_proxy() {
    if [ -n "$VPN_IP" ]; then
        if ! iptables -t nat -C POSTROUTING -j MASQUERADE -s $VPN_IP >/dev/null 2>&1; then
            echo "Tambahkan proxy untuk $VPN_IP ..."
            run "iptables -t nat -A POSTROUTING -j MASQUERADE -s $VPN_IP"
        fi
    else
        if ! iptables -t nat -C POSTROUTING -j MASQUERADE >/dev/null 2>&1; then
            echo "Tambahkan proxy untuk semua ..."
            run "iptables -t nat -A POSTROUTING -j MASQUERADE"
        fi
    fi
}


proxy() {
    reject_proxy
    allow_proxy
}


reject_reverse_proxy() {
    while IFS= read -r line; do
        if [ -z "$VPN_IP" ]; then
            echo "Hapus reverse proxy karena tidak ada penetapan IP VPN-nya ..."
            run "${line/#-A/iptables -t nat -D}"
            continue
        fi
        local ip=$(grep -oP '(?<=--to-destination )[0-9.]+' <<< "$line")
        if [ ! "$ip" = "$VPN_IP" ]; then
            echo "Hapus reverse proxy ke $ip karena tidak terdaftar di file $PROXY_FILE ..."
            run "${line/#-A/iptables -t nat -D}"
            continue
        fi
        if [ -n "$whitelist_ips" ]; then
            if ! echo "$line" | grep whitelist >/dev/null 2>&1; then
                echo "Hapus reverse proxy karena tidak ada kata whitelist ..."
                run "${line/#-A/iptables -t nat -D}"
                continue
            fi
        else
            if [ -n "$blacklist_ips" ]; then
                if ! echo "$line" | grep blacklist >/dev/null 2>&1; then
                    echo "Hapus reverse proxy karena tidak ada kata blacklist ..."
                    run "${line/#-A/iptables -t nat -D}"
                    continue
                fi
            fi
        fi
        if [ -z "$whitelist_ips" ] && [ -z "$blacklist_ips" ]; then
            local found_whitelist=$(echo "$line" | grep whitelist)
            local found_blacklist=$(echo "$line" | grep blacklist)
            if [ -n "$found_whitelist" ] || [ -n "$found_blacklist" ]; then
                echo "Hapus reverse proxy karena tidak ada lagi penetapan whitelist maupun blacklist ..."
                run "${line/#-A/iptables -t nat -D}"
                continue
            fi
        fi
        if [ -n "$VPN_PORTS" ]; then
            if echo "$line" | grep $SERVER_PORTS >/dev/null 2>&1; then
                echo "Hapus reverse proxy karena ada penetapan port menjadi $VPN_PORTS ..."
                run "${line/#-A/iptables -t nat -D}"
                continue
            fi
        fi
        if echo "$line" | grep $SERVER_PORTS >/dev/null 2>&1; then
            local dports=""
        else
            local dports=$(grep -oP '(?<=--dports )[0-9,]+' <<< "$line")
        fi
        if [ "$dports" = "$VPN_PORTS" ]; then
            continue
        fi
        if [ -n "$VPN_PORTS" ]; then
            if [ -n "$dports" ]; then
                echo "Hapus reverse proxy karena perubahan port $dports menjadi $VPN_PORTS ..."
                run "${line/#-A/iptables -t nat -D}"
                continue
            fi
        fi
        if [ -n "$dports" ]; then
            echo "Hapus reverse proxy karena kini boleh ke semua port ..."
        else
            echo "Hapus reverse proxy ..."
        fi
        run "${line/#-A/iptables -t nat -D}"
    done < <(iptables -t nat -S PREROUTING | grep -e "-j DNAT") || exit 1
}


allow_reverse_proxy() {
    if [ -z "$VPN_IP" ]; then
        return 0
    fi
    if [ -n "$VPN_PORTS" ]; then
        if [ -n "$whitelist_ips" ]; then
            if ! iptables -t nat -C PREROUTING -p tcp -m set --match-set whitelist src -d $PUBLIC_IP -m multiport --dports $VPN_PORTS -j DNAT --to-destination $VPN_IP >/dev/null 2>&1; then
                echo "Tambahkan reverse proxy ke $VPN_IP port $VPN_PORTS khusus untuk $whitelist_ips ..."
                run "iptables -t nat -I PREROUTING -p tcp -m set --match-set whitelist src -d $PUBLIC_IP -m multiport --dports $VPN_PORTS -j DNAT --to-destination $VPN_IP"
            fi
        else
            if [ -n "$blacklist_ips" ]; then
                if ! iptables -t nat -C PREROUTING -p tcp -m set ! --match-set blacklist src -d $PUBLIC_IP -m multiport --dports $VPN_PORTS -j DNAT --to-destination $VPN_IP >/dev/null 2>&1; then
                    echo "Tambahkan reverse proxy ke $VPN_IP port $VPN_PORTS kecuali untuk $blacklist_ips ..." 
                    run "iptables -t nat -I PREROUTING -p tcp -m set ! --match-set blacklist src -d $PUBLIC_IP -m multiport --dports $VPN_PORTS -j DNAT --to-destination $VPN_IP"
                fi
            else
                if ! iptables -t nat -C PREROUTING -p tcp -d $PUBLIC_IP -m multiport --dports $VPN_PORTS -j DNAT --to-destination $VPN_IP >/dev/null 2>&1; then
                    echo "Tambahkan reverse proxy ke $VPN_IP port $VPN_PORTS ..." 
                    run "iptables -t nat -I PREROUTING -p tcp -d $PUBLIC_IP -m multiport --dports $VPN_PORTS -j DNAT --to-destination $VPN_IP"
                fi
            fi
        fi
    else
        if [ -n "$whitelist_ips" ]; then
            if ! iptables -t nat -C PREROUTING -p tcp -m set --match-set whitelist src -d $PUBLIC_IP -m multiport ! --dports $SERVER_PORTS -j DNAT --to-destination $VPN_IP >/dev/null 2>&1; then
                echo "Tambahkan reverse proxy ke $VPN_IP khusus untuk $whitelist_ips ..."
                run "iptables -t nat -I PREROUTING -p tcp -m set --match-set whitelist src -d $PUBLIC_IP -m multiport ! --dports $SERVER_PORTS -j DNAT --to-destination $VPN_IP"
            fi
        else
            if [ -n "$blacklist_ips" ]; then
                if ! iptables -t nat -C PREROUTING -p tcp -m set ! --match-set blacklist src -d $PUBLIC_IP -m multiport ! --dports $SERVER_PORTS -j DNAT --to-destination $VPN_IP >/dev/null 2>&1; then
                    echo "Tambahkan reverse proxy ke $VPN_IP kecuali untuk $blacklist_ips ..."
                    run "iptables -t nat -I PREROUTING -p tcp -m set ! --match-set blacklist src -d $PUBLIC_IP -m multiport ! --dports $SERVER_PORTS -j DNAT --to-destination $VPN_IP"
                fi
            else
                if ! iptables -t nat -C PREROUTING -p tcp -d $PUBLIC_IP -m multiport ! --dports $SERVER_PORTS -j DNAT --to-destination $VPN_IP >/dev/null 2>&1; then
                    echo "Tambahkan reverse proxy ke $VPN_IP ..."
                    run "iptables -t nat -I PREROUTING -p tcp -d $PUBLIC_IP -m multiport ! --dports $SERVER_PORTS -j DNAT --to-destination $VPN_IP"
                fi
            fi
        fi
    fi
}


reverse_proxy() {
    reject_reverse_proxy
    allow_reverse_proxy
}


proxy
reverse_proxy


if [ -n "$IS_CHANGED" ]; then
    echo "Simpan ..."
    run "iptables-save > /etc/iptables/rules.v4"

fi
