<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title metal:define-slot="title">OpenVPN Web Management</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="${request.static_url('webmin_openvpn:static/css/custom.css')}" rel="stylesheet">
</head>
<body class="bg-body-tertiary d-flex flex-column min-vh-100">

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="${request.route_url('admin_dashboard')}">
                <span class="brand-icon d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-3 p-2 shadow-sm">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </span>
                <span>Webmin <span class="badge bg-white text-primary fw-bold text-uppercase ms-1 px-2 py-1 fs-7">OpenVPN</span></span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Admin Menu -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0" tal:condition="request.user">
                    <li class="nav-item">
                        <a class="nav-link ${'active' if request.matched_route and request.matched_route.name == 'admin_dashboard' else ''}" href="${request.route_url('admin_dashboard')}">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ${'active' if request.matched_route and request.matched_route.name == 'admin_create_cert' else ''}" href="${request.route_url('admin_create_cert')}">
                            <i class="bi bi-plus-circle me-1"></i> Buat Sertifikat
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ${'active' if request.matched_route and request.matched_route.name in ['admin_users', 'admin_edit_user_password'] else ''}" href="${request.route_url('admin_users')}">
                            <i class="bi bi-people me-1"></i> Daftar User
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ${'active' if request.matched_route and request.matched_route.name == 'admin_change_password' else ''}" href="${request.route_url('admin_change_password')}">
                            <i class="bi bi-key me-1"></i> Ubah Password
                        </a>
                    </li>
                </ul>

                <!-- User & Auth Menu -->
                <ul class="navbar-nav ms-auto align-items-lg-center gap-2" tal:condition="request.user">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-white bg-white bg-opacity-10 rounded-pill px-3 py-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="fw-semibold">${request.user.user_name}</span>
                            <span class="badge bg-warning text-dark rounded-pill text-uppercase fs-8">Admin</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                            <li class="dropdown-header">
                                <span class="d-block text-muted small">Login sebagai</span>
                                <strong>${request.user.user_name}</strong>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="${request.route_url('admin_change_password')}">
                                    <i class="bi bi-key me-2 text-primary"></i> Ubah Password Saya
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger fw-semibold" href="${request.route_url('logout')}">
                                    <i class="bi bi-box-arrow-right me-2"></i> Keluar (Logout)
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

                <!-- Login button for guest -->
                <ul class="navbar-nav ms-auto" tal:condition="not request.user">
                    <li class="nav-item">
                        <a class="btn btn-outline-light rounded-pill px-4" href="${request.route_url('login')}">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Masuk
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Flash Messages Container -->
    <div class="container mt-4" tal:define="
        danger_msgs request.session.pop_flash('danger');
        success_msgs request.session.pop_flash('success');
        warning_msgs request.session.pop_flash('warning');
        info_msgs request.session.pop_flash('info');
    ">
        <div tal:repeat="msg success_msgs" class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>${msg}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <div tal:repeat="msg danger_msgs" class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
            <div>${msg}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <div tal:repeat="msg warning_msgs" class="alert alert-warning alert-dismissible fade show d-flex align-items-center shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-exclamation-circle-fill fs-5 me-2 text-warning"></i>
            <div>${msg}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <div tal:repeat="msg info_msgs" class="alert alert-info alert-dismissible fade show d-flex align-items-center shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-info-circle-fill fs-5 me-2 text-info"></i>
            <div>${msg}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="container my-4 flex-grow-1">
        <div metal:define-slot="content">
            <!-- Page Content Injected Here -->
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container text-center text-muted small">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                    <i class="bi bi-shield-check text-primary me-1"></i>
                    <strong>OpenVPN Management Portal</strong> &mdash; Secured with PostgreSQL &amp; Ziggurat Foundations
                </div>
                <div>
                    Pyramid Web Framework &bull; Chameleon &bull; Bootstrap 5
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="${request.static_url('webmin_openvpn:static/js/app.js')}"></script>
</body>
</html>
