<html metal:use-macro="load: webmin_openvpn:templates/layout.pt">
<head>
    <title metal:fill-slot="title">Dashboard Admin - OpenVPN Management</title>
</head>
<body>
    <div metal:fill-slot="content">
        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
            <div>
                <h2 class="fw-bold text-dark mb-1">
                    <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard Administrator
                </h2>
                <p class="text-muted mb-0">Panel kendali sertifikat OpenVPN dan manajemen akun pengguna.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="${request.route_url('admin_create_cert')}" class="btn btn-primary rounded-3 shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i>
                    <span>Buat Sertifikat Baru</span>
                </a>
            </div>
        </div>

        <!-- Htop Real-Time System Monitor -->
        <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden htop-card">
            <div class="card-header bg-dark text-white border-0 py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="htop-term-btn bg-danger"></span>
                    <span class="htop-term-btn bg-warning"></span>
                    <span class="htop-term-btn bg-success"></span>
                    <span class="fw-bold font-monospace ms-2 text-info fs-6">
                        <i class="bi bi-terminal-fill me-1"></i>SYSTEM MONITOR [htop]
                    </span>
                </div>
                <div class="d-flex align-items-center gap-3 font-monospace small">
                    <span class="text-white-50 d-none d-md-inline" id="htop-load-avg">Load: ${', '.join(str(x) for x in system_stats['cpu']['load_avg'])}</span>
                    <span class="badge bg-success bg-opacity-75 d-inline-flex align-items-center gap-1">
                        <span class="spinner-grow spinner-grow-sm text-light" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                        <span>LIVE 1s</span>
                    </span>
                </div>
            </div>
            <div class="card-body bg-dark text-light p-4 font-monospace htop-body">
                <div class="row g-3">
                    <!-- Left Column: CPU, RAM, Swap -->
                    <div class="col-12 col-lg-6">
                        <!-- CPU Meter -->
                        <div class="htop-meter-row mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="htop-label text-info fw-bold" style="min-width: 65px;">CPU</span>
                                <div class="htop-bar-bracket text-secondary">[</div>
                                <div class="htop-bar-track flex-grow-1 position-relative">
                                    <div class="htop-bar-fill bg-info" id="bar-cpu" style="width: ${system_stats['cpu']['percent']}%;"></div>
                                    <span class="htop-bar-text" id="text-cpu">${system_stats['cpu']['percent']}% (${system_stats['cpu']['cores']} Cores)</span>
                                </div>
                                <div class="htop-bar-bracket text-secondary">]</div>
                                <span class="htop-pct fw-bold text-info" id="pct-cpu" style="min-width: 55px; text-align: right;">${system_stats['cpu']['percent']}%</span>
                            </div>
                        </div>

                        <!-- RAM Meter -->
                        <div class="htop-meter-row mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="htop-label text-success fw-bold" style="min-width: 65px;">Mem</span>
                                <div class="htop-bar-bracket text-secondary">[</div>
                                <div class="htop-bar-track flex-grow-1 position-relative">
                                    <div class="htop-bar-fill bg-success" id="bar-ram" style="width: ${system_stats['ram']['percent']}%;"></div>
                                    <span class="htop-bar-text" id="text-ram">${system_stats['ram']['used_gb']}G/${system_stats['ram']['total_gb']}G</span>
                                </div>
                                <div class="htop-bar-bracket text-secondary">]</div>
                                <span class="htop-pct fw-bold text-success" id="pct-ram" style="min-width: 55px; text-align: right;">${system_stats['ram']['percent']}%</span>
                            </div>
                        </div>

                        <!-- SWAP Meter -->
                        <div class="htop-meter-row">
                            <div class="d-flex align-items-center gap-2">
                                <span class="htop-label text-danger fw-bold" style="min-width: 65px;">Swp</span>
                                <div class="htop-bar-bracket text-secondary">[</div>
                                <div class="htop-bar-track flex-grow-1 position-relative">
                                    <div class="htop-bar-fill bg-danger" id="bar-swap" style="width: ${system_stats['swap']['percent']}%;"></div>
                                    <span class="htop-bar-text" id="text-swap">${system_stats['swap']['used_gb']}G/${system_stats['swap']['total_gb']}G</span>
                                </div>
                                <div class="htop-bar-bracket text-secondary">]</div>
                                <span class="htop-pct fw-bold text-danger" id="pct-swap" style="min-width: 55px; text-align: right;">${system_stats['swap']['percent']}%</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Storage, Network RX, Network TX -->
                    <div class="col-12 col-lg-6">
                        <!-- Storage Meter -->
                        <div class="htop-meter-row mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="htop-label text-warning fw-bold" style="min-width: 65px;">Disk</span>
                                <div class="htop-bar-bracket text-secondary">[</div>
                                <div class="htop-bar-track flex-grow-1 position-relative">
                                    <div class="htop-bar-fill bg-warning" id="bar-disk" style="width: ${system_stats['disk']['percent']}%;"></div>
                                    <span class="htop-bar-text text-dark" id="text-disk">${system_stats['disk']['used_gb']}G/${system_stats['disk']['total_gb']}G</span>
                                </div>
                                <div class="htop-bar-bracket text-secondary">]</div>
                                <span class="htop-pct fw-bold text-warning" id="pct-disk" style="min-width: 55px; text-align: right;">${system_stats['disk']['percent']}%</span>
                            </div>
                        </div>

                        <!-- Network RX Meter -->
                        <div class="htop-meter-row mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="htop-label text-primary fw-bold" style="min-width: 65px;">Net RX</span>
                                <div class="htop-bar-bracket text-secondary">[</div>
                                <div class="htop-bar-track flex-grow-1 position-relative">
                                    <div class="htop-bar-fill bg-primary" id="bar-rx" style="width: ${system_stats['network']['rx_percent']}%;"></div>
                                    <span class="htop-bar-text" id="text-rx">${system_stats['network']['rx_speed_str']} (Tot: ${system_stats['network']['rx_total_mb']} MB)</span>
                                </div>
                                <div class="htop-bar-bracket text-secondary">]</div>
                                <span class="htop-pct fw-bold text-primary" id="pct-rx" style="min-width: 55px; text-align: right;">${system_stats['network']['rx_percent']}%</span>
                            </div>
                        </div>

                        <!-- Network TX Meter -->
                        <div class="htop-meter-row">
                            <div class="d-flex align-items-center gap-2">
                                <span class="htop-label fw-bold" style="min-width: 65px; color: #c084fc;">Net TX</span>
                                <div class="htop-bar-bracket text-secondary">[</div>
                                <div class="htop-bar-track flex-grow-1 position-relative">
                                    <div class="htop-bar-fill" id="bar-tx" style="background-color: #a855f7; width: ${system_stats['network']['tx_percent']}%;"></div>
                                    <span class="htop-bar-text" id="text-tx">${system_stats['network']['tx_speed_str']} (Tot: ${system_stats['network']['tx_total_mb']} MB)</span>
                                </div>
                                <div class="htop-bar-bracket text-secondary">]</div>
                                <span class="htop-pct fw-bold" id="pct-tx" style="min-width: 55px; text-align: right; color: #c084fc;">${system_stats['network']['tx_percent']}%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 h-100 stat-card">
                    <div class="card-body p-4 d-flex align-items-center gap-3">
                        <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3 d-flex align-items-center justify-content-center">
                            <i class="bi bi-people-fill fs-2"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Total Pengguna</span>
                            <h3 class="fw-bold mb-0 text-dark">${users_count}</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 h-100 stat-card">
                    <div class="card-body p-4 d-flex align-items-center gap-3">
                        <div class="stat-icon bg-success-subtle text-success rounded-3 p-3 d-flex align-items-center justify-content-center">
                            <i class="bi bi-file-earmark-lock2-fill fs-2"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Sertifikat Tersedia</span>
                            <h3 class="fw-bold mb-0 text-dark">${cert_count}</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 h-100 stat-card">
                    <div class="card-body p-4 d-flex align-items-center gap-3">
                        <div class="stat-icon bg-info-subtle text-info rounded-3 p-3 d-flex align-items-center justify-content-center">
                            <i class="bi bi-hdd-network-fill fs-2"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Direktori Sertifikat</span>
                            <h6 class="fw-bold mb-0 text-dark text-truncate" style="max-width: 200px;" title="${client_dir}">${client_dir}</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Recent Users -->
        <div class="row g-4">
            <!-- Left: Quick Action Panels -->
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-lightning-charge text-warning me-2"></i>Menu Cepat
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="list-group list-group-flush gap-2">
                            <a href="${request.route_url('admin_create_cert')}" class="list-group-item list-group-item-action rounded-3 border-0 bg-body-tertiary p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="bg-primary text-white rounded-3 p-2">
                                        <i class="bi bi-plus-circle-fill fs-5"></i>
                                    </span>
                                    <div>
                                        <strong class="d-block text-dark">Buat Sertifikat OpenVPN</strong>
                                        <small class="text-muted">Generate cert &amp; akun user baru</small>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>

                            <a href="${request.route_url('admin_users')}" class="list-group-item list-group-item-action rounded-3 border-0 bg-body-tertiary p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="bg-success text-white rounded-3 p-2">
                                        <i class="bi bi-people-fill fs-5"></i>
                                    </span>
                                    <div>
                                        <strong class="d-block text-dark">Daftar Pengguna</strong>
                                        <small class="text-muted">Kelola akun &amp; ubah password</small>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>

                            <a href="${request.route_url('admin_change_password')}" class="list-group-item list-group-item-action rounded-3 border-0 bg-body-tertiary p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="bg-secondary text-white rounded-3 p-2">
                                        <i class="bi bi-key-fill fs-5"></i>
                                    </span>
                                    <div>
                                        <strong class="d-block text-dark">Ubah Password Saya</strong>
                                        <small class="text-muted">Ganti password akun admin saat ini</small>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Recent Users Table -->
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>Daftar Klien Terbaru
                        </h5>
                        <a href="${request.route_url('admin_users')}" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Lihat Semua <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Username</th>
                                        <th>Berkas Sertifikat (.tgz)</th>
                                        <th>Waktu Modifikasi</th>
                                        <th class="text-end">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr tal:repeat="item recent_users">
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-circle fs-5 text-secondary"></i>
                                                <span class="fw-semibold">${item['username']}</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-file-earmark-zip-fill me-1"></i>${item['filename']} (${item['size_kb']} KB)
                                            </span>
                                        </td>
                                        <td class="text-muted small">
                                            ${item['modified']}
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a href="${request.route_url('admin_download_cert', username=item['username'])}" 
                                                   class="btn btn-outline-success rounded-start-3" 
                                                   title="Unduh Sertifikat">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                <a href="${request.route_url('admin_edit_user_password', username=item['username'])}" 
                                                   class="btn btn-outline-primary rounded-end-3" 
                                                   title="Ubah Password">
                                                    <i class="bi bi-key-fill"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr tal:condition="not recent_users">
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            Belum ada berkas sertifikat di direktori klien.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <style>
        .htop-card {
            background-color: #0b1118 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
        }
        .htop-term-btn {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            display: inline-block;
        }
        .htop-body {
            background-color: #0d1520 !important;
        }
        .htop-bar-bracket {
            font-size: 1.15rem;
            font-weight: 700;
            line-height: 1;
            user-select: none;
        }
        .htop-bar-track {
            height: 22px;
            background-color: #16202e;
            border-radius: 3px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(255, 255, 255, 0.07);
        }
        .htop-bar-fill {
            height: 100%;
            transition: width 0.3s ease-out;
            background-image: repeating-linear-gradient(
                90deg,
                rgba(0, 0, 0, 0.25),
                rgba(0, 0, 0, 0.25) 2px,
                transparent 2px,
                transparent 5px
            );
        }
        .htop-bar-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 0.72rem;
            font-weight: 700;
            white-space: nowrap;
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
            color: #ffffff;
            pointer-events: none;
            letter-spacing: 0.02em;
        }
        </style>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
            var statsUrl = "${request.route_url('admin_system_stats')}";

            function updateStats() {
                fetch(statsUrl)
                    .then(function(res) {
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        return res.json();
                    })
                    .then(function(data) {
                        if (!data) return;

                        // CPU
                        var cpuBar = document.getElementById('bar-cpu');
                        var cpuTxt = document.getElementById('text-cpu');
                        var cpuPct = document.getElementById('pct-cpu');
                        var cpuVal = Math.min(100, Math.max(0, data.cpu.percent));
                        if (cpuBar) {
                            cpuBar.style.width = cpuVal + '%';
                            if (cpuVal > 85) cpuBar.className = 'htop-bar-fill bg-danger';
                            else if (cpuVal > 65) cpuBar.className = 'htop-bar-fill bg-warning';
                            else cpuBar.className = 'htop-bar-fill bg-info';
                        }
                        if (cpuTxt) cpuTxt.innerText = cpuVal + '% (' + data.cpu.cores + ' Cores)';
                        if (cpuPct) cpuPct.innerText = cpuVal + '%';

                        // Load average
                        var loadEl = document.getElementById('htop-load-avg');
                        if (loadEl && data.cpu.load_avg) {
                            loadEl.innerText = 'Load: ' + data.cpu.load_avg.join(', ');
                        }

                        // RAM
                        var ramBar = document.getElementById('bar-ram');
                        var ramTxt = document.getElementById('text-ram');
                        var ramPct = document.getElementById('pct-ram');
                        var ramVal = Math.min(100, Math.max(0, data.ram.percent));
                        if (ramBar) {
                            ramBar.style.width = ramVal + '%';
                            if (ramVal > 90) ramBar.className = 'htop-bar-fill bg-danger';
                            else if (ramVal > 75) ramBar.className = 'htop-bar-fill bg-warning';
                            else ramBar.className = 'htop-bar-fill bg-success';
                        }
                        if (ramTxt) ramTxt.innerText = data.ram.used_gb + 'G/' + data.ram.total_gb + 'G';
                        if (ramPct) ramPct.innerText = ramVal + '%';

                        // Swap
                        var swpBar = document.getElementById('bar-swap');
                        var swpTxt = document.getElementById('text-swap');
                        var swpPct = document.getElementById('pct-swap');
                        var swpVal = Math.min(100, Math.max(0, data.swap.percent));
                        if (swpBar) swpBar.style.width = swpVal + '%';
                        if (swpTxt) swpTxt.innerText = data.swap.used_gb + 'G/' + data.swap.total_gb + 'G';
                        if (swpPct) swpPct.innerText = swpVal + '%';

                        // Disk
                        var dskBar = document.getElementById('bar-disk');
                        var dskTxt = document.getElementById('text-disk');
                        var dskPct = document.getElementById('pct-disk');
                        var dskVal = Math.min(100, Math.max(0, data.disk.percent));
                        if (dskBar) swpBar && (dskBar.style.width = dskVal + '%');
                        if (dskTxt) dskTxt.innerText = data.disk.used_gb + 'G/' + data.disk.total_gb + 'G';
                        if (dskPct) dskPct.innerText = dskVal + '%';

                        // Network RX
                        var rxBar = document.getElementById('bar-rx');
                        var rxTxt = document.getElementById('text-rx');
                        var rxPct = document.getElementById('pct-rx');
                        var rxVal = Math.min(100, Math.max(0, data.network.rx_percent));
                        if (rxBar) rxBar.style.width = rxVal + '%';
                        if (rxTxt) rxTxt.innerText = data.network.rx_speed_str + ' (Tot: ' + data.network.rx_total_mb + ' MB)';
                        if (rxPct) rxPct.innerText = rxVal + '%';

                        // Network TX
                        var txBar = document.getElementById('bar-tx');
                        var txTxt = document.getElementById('text-tx');
                        var txPct = document.getElementById('pct-tx');
                        var txVal = Math.min(100, Math.max(0, data.network.tx_percent));
                        if (txBar) txBar.style.width = txVal + '%';
                        if (txTxt) txTxt.innerText = data.network.tx_speed_str + ' (Tot: ' + data.network.tx_total_mb + ' MB)';
                        if (txPct) txPct.innerText = txVal + '%';
                    })
                    .catch(function(err) {
                        console.warn('System stats update error:', err);
                    });
            }

            // Real-time update every second
            setInterval(updateStats, 1000);
        });
        </script>

    </div>
</body>
</html>
