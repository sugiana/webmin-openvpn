<html metal:use-macro="load: webmin_openvpn:templates/layout.pt">
<head>
    <title metal:fill-slot="title">Verifikasi 2FA - OpenVPN Web Management</title>
</head>
<body>
    <div metal:fill-slot="content">
        <div class="row justify-content-center align-items-center min-vh-70 py-4">
            <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
                
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-gradient-primary text-white p-4 text-center border-0 position-relative">
                        <div class="login-badge-icon bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow mb-2 p-3" style="width: 64px; height: 64px;">
                            <i class="bi bi-shield-lock-fill fs-2"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Verifikasi 2FA</h4>
                        <p class="text-white-50 small mb-0">Google Authenticator Verification</p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small mb-2">
                                <i class="bi bi-person-fill text-primary me-1"></i> ${username}
                            </span>
                            <p class="text-muted small mb-0">
                                Buka aplikasi <strong>Google Authenticator</strong> pada perangkat Android Anda dan masukkan 6 angka kode verifikasi.
                            </p>
                        </div>

                        <form method="POST" action="${request.route_url('login_2fa')}" id="form2FA">
                            
                            <div class="mb-4">
                                <label for="token" class="form-label fw-semibold text-secondary small text-center d-block">KODE VERIFIKASI (6 DIGIT)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted">
                                        <i class="bi bi-key-fill"></i>
                                    </span>
                                    <input 
                                        type="text" 
                                        class="form-control bg-light border-start-0 rounded-end-3 py-2 text-center font-monospace fw-bold fs-4" 
                                        id="token" 
                                        name="token" 
                                        placeholder="000000" 
                                        maxlength="6" 
                                        pattern="[0-9]{6}" 
                                        inputmode="numeric" 
                                        autocomplete="one-time-code" 
                                        required 
                                        autofocus
                                        style="letter-spacing: 0.35rem;"
                                    />
                                </div>
                                <div class="form-text small text-center">Kode berganti setiap 30 detik.</div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-check2-circle fs-5"></i>
                                    <span>Verifikasi &amp; Masuk</span>
                                </button>
                                
                                <button type="submit" name="action" value="cancel" class="btn btn-outline-secondary rounded-3 py-2 mt-2">
                                    <i class="bi bi-arrow-left me-1"></i> Batal / Kembali ke Login
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer bg-light p-3 text-center border-0 small text-muted">
                        <i class="bi bi-info-circle me-1"></i> Pastikan jam di HP Android Anda sinkron agar kode valid.
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>
